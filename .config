#
# ImmortalWrt 25.12  defconfig  ---  CMCC RAX3000M
#
# 由 immortalwrt-mt798x-rebase (25.12 分支, HEAD 458d2f7e, 2026-11-15) 重新生成
# 生成方式: 用旧 .config 跑 make defconfig -> make diffconfig (config.buildinfo)
# 验证:     本文件作为 .config 跑 make defconfig，输出与重新生成的完整 .config 逐字节一致
#
# 用法:
#   本文件就是仓库里的 .config，workflow 的 CONFIG_FILE=.config 不需要改。
#   Actions 会先把它 mv 成 openwrt/.config，再 make defconfig 自动补齐其余默认值。
#
# 说明:
#   - 这里只记录“非默认值”。其余 9000+ 行 CONFIG_* 由 make defconfig 按
#     target/package 元数据自动补齐，不需要也不能手写。
#   - 换设备请改 CONFIG_TARGET_*_DEVICE_* 三行。
#   - 依赖的额外源码包（diy-part1.sh 克隆，不在 feeds 里）:
#       package/mosdns          <- sbwml/luci-app-mosdns (v5)
#       package/v2ray-geodata   <- sbwml/v2ray-geodata
#       package/netspeedtest    <- sirpdboy/NetSpeedTest
#     缺少这些目录时，对应的 CONFIG_PACKAGE_* 会被静默丢弃。
#

#######################################################################
#  TARGET / DEVICE
#######################################################################
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y

#######################################################################
#  TOOLCHAIN
#######################################################################
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BINUTILS_USE_VERSION_2_42=y
# CONFIG_BINUTILS_USE_VERSION_2_44 is not set
CONFIG_BINUTILS_VERSION="2.42"
CONFIG_BINUTILS_VERSION_2_42=y
CONFIG_GCC_USE_VERSION_13=y
# CONFIG_GCC_USE_VERSION_14 is not set
CONFIG_GCC_VERSION="13.4.0"
CONFIG_GCC_VERSION_13=y

